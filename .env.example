# --- Auth (Continue with Google) ---
# Generate with: npx auth secret   (or: openssl rand -base64 32)
AUTH_SECRET=
# Google Cloud Console > APIs & Services > Credentials > OAuth client ID (Web application)
# Authorized redirect URI: http://localhost:3000/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# Needed when self-hosting (not on Vercel)
AUTH_TRUST_HOST=true

# Comma-separated Google accounts allowed into the admin panel
ADMIN_EMAILS=you@example.com

# --- Shop payments (optional) ---
# Without a Stripe key, checkout saves the order as "pending" for you to follow up on.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
CURRENCY=usd

# Public URL of the site (used for Stripe redirect URLs)
SITE_URL=http://localhost:3000

# Where the SQLite database and uploaded media are stored (default: ./data)
DATA_DIR=
