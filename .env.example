# Copy to .env.local for local development.
# In production these are set in apphosting.yaml instead.

# Firebase web app config: Firebase console > Project settings > Your apps > Web app
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Server access to Firebase when running locally against your real project:
# Project settings > Service accounts > Generate new private key, then paste the
# JSON on one line. Not needed on App Hosting or when using the emulators.
FIREBASE_SERVICE_ACCOUNT_KEY=

# Comma-separated Google accounts allowed into the admin panel
ADMIN_EMAILS=you@example.com

# Asaas payments (Pix, boleto, card). Without a key, orders are saved as "pending".
# Asaas > Integrations > API key. Use a sandbox key with ASAAS_ENV=sandbox while testing.
# Keys start with "$": write it as \$aact_... here, or the $ part gets dropped.
ASAAS_API_KEY=
ASAAS_ENV=sandbox
# Any long random string; set the same value as the webhook's auth token in Asaas.
ASAAS_WEBHOOK_TOKEN=
# Optional: the site works out its own address; set this only to override it.
SITE_URL=
