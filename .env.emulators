# Used by `npm run dev:emulators` — talks to the local Firebase emulators, no real project needed.
NEXT_PUBLIC_FIREBASE_EMULATORS=true
NEXT_PUBLIC_FIREBASE_API_KEY=demo-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=demo-yideaz.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=demo-yideaz
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=demo-yideaz.appspot.com
NEXT_PUBLIC_FIREBASE_APP_ID=demo-app
FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
FIREBASE_STORAGE_EMULATOR_HOST=127.0.0.1:9199
ADMIN_EMAILS=admin@example.com
